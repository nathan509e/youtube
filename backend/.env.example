# Copy this file to backend/.env and adjust for your VPS before running docker compose up

# Server Port (must match docker-compose.yml's backend port and nginx.conf's proxy_pass)
PORT=3001

# Public URL of the frontend (used for CORS)
FRONTEND_URL=https://yourdomain.com

# Security & Limits
MAX_VIDEO_DURATION=1800
MAX_CONCURRENT_DOWNLOADS=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Optional: path to a cookies.txt file (see docker-compose.yml for the volume mount)
# Improves download success rate / unlocks higher qualities for age-restricted
# or rate-limited videos. Leave empty to rely on yt-dlp's anonymous access.
YT_COOKIES_PATH=
